#cloud-config
# Control-plane joining replica (cp-1 / cp-2). Polls SSM for the cluster join
# token published by cp-0, then boots in etcd join mode: the /v1/cluster/join
# redemption fetches the cluster CA and computes this member's initial-cluster,
# so no peer topology is configured here.
package_update: true
packages:
  - awscli
  - jq
  - curl
  - ca-certificates
runcmd:
  - |
    set -ex
    export HOME=/root
    export AWS_DEFAULT_REGION=${region}

    SSM_PREFIX="/otherix/${env_name}"
    VER="${otherix_version}"
    if [ -z "$${VER}" ]; then
      # No pinned version: resolve the latest published release at boot so a bare
      # tofu apply (no otherix_version) installs the newest release.
      loc="$(curl -fsSLI -o /dev/null -w '%%{url_effective}' https://github.com/otherix/otherix/releases/latest)"
      loc="$${loc##*/tag/}"
      VER="$${loc#v}"
    fi
    RELEASE="https://github.com/otherix/otherix/releases/download/v$${VER}"
    # Match the running instance architecture (arm64/amd64) so changing
    # the instance type still installs the right artifact.
    ARCH="$(dpkg --print-architecture)"

    # Mask the unit before install so the package postinstall does not start
    # otherix-api with the packaged single-node defaults before the harness
    # join config lands (a premature single-node boot would initialise the
    # etcd data dir and break the subsequent join).
    mkdir -p /etc/otherix
    ln -sf /dev/null /etc/systemd/system/otherix-api.service
    # Unmask on any exit path: a failure between mask and the intended unmask
    # (an SSM read, an apt step) would otherwise leave the unit permanently
    # masked, and cloud-init runcmd runs once per instance with no re-apply.
    trap 'rm -f /etc/systemd/system/otherix-api.service' EXIT

    curl -fsSL --retry 5 --retry-delay 5 -o /tmp/otherix-api.deb "$RELEASE/otherix-api_$${VER}_$${ARCH}.deb"
    apt-get install -y /tmp/otherix-api.deb || { dpkg -i /tmp/otherix-api.deb || true; apt-get install -f -y; }

    # This replica shares the cluster JWT secret (same signing key across all
    # replicas). It does NOT set the bootstrap-admin vars: the admin already
    # exists in the shared store, and setting only one of the pair is fatal.
    JWT="$(aws ssm get-parameter --name "$SSM_PREFIX/jwt_secret" --with-decryption --query Parameter.Value --output text --region ${region})"
    umask 077
    cat > /etc/otherix/api.env <<EOF
    OTHERIX_AUTH__JWT_SECRET=$JWT
    EOF

    # Poll SSM until cp-0 has published the cluster join token.
    TOK="pending"
    for i in $(seq 1 120); do
      TOK="$(aws ssm get-parameter --name "$SSM_PREFIX/join_token_cluster" --with-decryption --query Parameter.Value --output text --region ${region} 2>/dev/null || true)"
      if [ -n "$TOK" ] && [ "$TOK" != "pending" ]; then break; fi
      sleep 5
    done
    # Keep the plaintext cluster token out of the persisted xtrace log.
    set +x
    printf '%s\n' "$TOK" > /etc/otherix/cluster-join-token
    set -x

    # cp-0 publishes ca_fingerprint LAST (after all three tokens), so poll it the
    # same way as the token: a bare read could catch it still "pending" and bake
    # that into api.yaml, crashlooping otherix-api.
    CA_FP="pending"
    for i in $(seq 1 120); do
      CA_FP="$(aws ssm get-parameter --name "$SSM_PREFIX/ca_fingerprint" --with-decryption --query Parameter.Value --output text --region ${region} 2>/dev/null || true)"
      if [ -n "$CA_FP" ] && [ "$CA_FP" != "pending" ]; then break; fi
      sleep 5
    done
    if [ "$CA_FP" = "pending" ] || [ -z "$CA_FP" ]; then
      echo "CA fingerprint never published to SSM" >&2
      exit 1
    fi

    # api.yaml carries the runtime CA fingerprint, so it is built here rather
    # than shipped statically. The heredoc is unquoted so $CA_FP expands; the
    # $${...} tokens are Terraform-interpolated at render time.
    cat > /etc/otherix/api.yaml <<EOF
    server:
      listen: "0.0.0.0:8080"
    agent_server:
      enabled: true
      listen: "0.0.0.0:8443"
    agent_client:
      enabled: true
    etcd:
      mode: "join"
      name: "${node_name}"
      peer_url: "auto"
    cluster_join:
      cp_url: "https://cp-0.${fqdn_internal}:8443"
      token_path: "/etc/otherix/cluster-join-token"
      ca_fingerprint: "$CA_FP"
    logger:
      level: "info"
      format: "json"
    cp_cert:
      additional_sans:
        - "cp.${fqdn_public}"
        - "cp.${fqdn_internal}"
    EOF

    chown otherix:otherix /etc/otherix/api.env /etc/otherix/api.yaml /etc/otherix/cluster-join-token
    chmod 0640 /etc/otherix/api.env /etc/otherix/cluster-join-token

    rm -f /etc/systemd/system/otherix-api.service
    systemctl daemon-reload
    systemctl enable --now otherix-api
