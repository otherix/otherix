#cloud-config
# Bare-metal agent node. Assembles the local NVMe instance-store into a storage
# pool under /var/lib/otherix/pools, installs the otherix-agent .deb (which
# boots the State A polling loop), then runs the join-token bootstrap against the
# control plane. The agent advertises its PRIVATE IP: the CP dials the agent for
# VM operations, and peer agents dial it for live-migration ingress.
package_update: true
packages:
  - unzip
  - jq
  - curl
  - ca-certificates
  - mdadm
runcmd:
  - |
    set -ex
    export HOME=/root
    export AWS_DEFAULT_REGION=${region}

    SSM_PREFIX="/otherix/${env_name}"
    VER="${otherix_version}"
    if [ -z "$${VER}" ]; then
      # No pinned version: resolve the latest published release at boot so a bare
      # tofu apply (no otherix_version) installs the newest release.
      loc="$(curl -fsSLI -o /dev/null -w '%%{url_effective}' https://github.com/otherix/otherix/releases/latest)"
      loc="$${loc##*/tag/}"
      VER="$${loc#v}"
    fi
    RELEASE="https://github.com/otherix/otherix/releases/download/v$${VER}"
    # Match the running instance architecture (arm64/amd64) so changing
    # the instance type still installs the right artifact.
    ARCH="$(dpkg --print-architecture)"

    # AWS CLI v2: the awscli apt package was dropped from Ubuntu 24.04, so
    # install it explicitly before any aws use. uname -m (aarch64/x86_64)
    # matches the official installer archive name.
    if ! command -v aws >/dev/null 2>&1; then
      curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscliv2.zip
      unzip -q /tmp/awscliv2.zip -d /tmp
      /tmp/aws/install
    fi

    # --- Storage pool on the local NVMe instance-store -----------------------
    # Instance-store volumes report model "Amazon EC2 NVMe Instance Storage";
    # the EBS root reports "Amazon Elastic Block Store" and is excluded. Collect
    # the instance-store devices into the positional params so $1/$2/$#/$@ work
    # without brace expansion (which would collide with template interpolation).
    NVME="$(lsblk -dno NAME,MODEL | awk '/Instance Storage/{print "/dev/"$1}')"
    set -- $NVME
    if [ "$#" -lt 1 ]; then
      echo "no instance-store NVMe devices detected" >&2
      exit 1
    fi

    mkdir -p /var/lib/otherix/pools
    if [ "${raid0_pool}" = "true" ]; then
      # Single RAID0 pool across every instance-store device.
      mdadm --create /dev/md0 --level=0 --raid-devices=$# $NVME --run
      mkfs.ext4 -F /dev/md0
      mkdir -p /var/lib/otherix/pools/local
      mount /dev/md0 /var/lib/otherix/pools/local
      UUID="$(blkid -s UUID -o value /dev/md0)"
      printf 'UUID=%s /var/lib/otherix/pools/local ext4 defaults,nofail 0 2\n' "$UUID" >> /etc/fstab
    else
      # One separate pool per device: local0, local1, ...
      i=0
      for d in "$@"; do
        mkfs.ext4 -F "$d"
        mkdir -p /var/lib/otherix/pools/local$i
        mount "$d" /var/lib/otherix/pools/local$i
        UUID="$(blkid -s UUID -o value "$d")"
        printf 'UUID=%s /var/lib/otherix/pools/local%s ext4 defaults,nofail 0 2\n' "$UUID" "$i" >> /etc/fstab
        i=$((i + 1))
      done
    fi

    # --- Install the agent .deb (arm64). The postinstall creates the otherix
    # system user and starts `otherix-agent serve`, which idles in State A until
    # bootstrap writes the cert material + agent.yaml (picked up within ~5s).
    curl -fsSL --retry 5 --retry-delay 5 -o /tmp/otherix-agent.deb "$RELEASE/otherix-agent_$${VER}_$${ARCH}.deb"
    apt-get install -y /tmp/otherix-agent.deb || { dpkg -i /tmp/otherix-agent.deb || true; apt-get install -f -y; }

    # Private IPv4 (no public IP on agents) used as the advertised + migration
    # host so the CP and peer agents can reach this node. The AMI enforces
    # IMDSv2 (http_tokens=required), so fetch a session token first; a bare
    # IMDSv1 GET returns 401/empty and would fail the read below.
    IMDS_TOKEN="$(curl -sX PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')"
    PRIV="$(curl -s -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)"
    if [ -z "$PRIV" ]; then
      echo "could not read local-ipv4 from IMDS" >&2
      exit 1
    fi

    # Poll SSM until cp-0 has published the node join token + CA fingerprint.
    NODE_TOKEN="pending"
    for i in $(seq 1 120); do
      NODE_TOKEN="$(aws ssm get-parameter --name "$SSM_PREFIX/join_token_node" --with-decryption --query Parameter.Value --output text --region ${region} 2>/dev/null || true)"
      if [ -n "$NODE_TOKEN" ] && [ "$NODE_TOKEN" != "pending" ]; then break; fi
      sleep 5
    done
    CA_FP="pending"
    for i in $(seq 1 120); do
      CA_FP="$(aws ssm get-parameter --name "$SSM_PREFIX/ca_fingerprint" --with-decryption --query Parameter.Value --output text --region ${region} 2>/dev/null || true)"
      if [ -n "$CA_FP" ] && [ "$CA_FP" != "pending" ]; then break; fi
      sleep 5
    done
    if [ "$NODE_TOKEN" = "pending" ] || [ -z "$NODE_TOKEN" ] || [ "$CA_FP" = "pending" ] || [ -z "$CA_FP" ]; then
      echo "join token or CA fingerprint never published to SSM" >&2
      exit 1
    fi
    # Normalize to exactly one sha256: prefix (--ca-fingerprint accepts it
    # optionally; SSM carries the bare hex, but strip defensively either way).
    CA_FP="$(printf '%s' "$CA_FP" | sed 's/^sha256://')"

    # --- Bootstrap: redeem the token, persist cert material + agent.yaml. The
    # running serve loop transitions State A -> State B on the next tick. Silence
    # xtrace so the join token plaintext does not land in the persisted log.
    set +x
    /usr/bin/otherix-agent bootstrap \
      --token "$NODE_TOKEN" \
      --ca-fingerprint "sha256:$CA_FP" \
      --cp-url "https://cp.${fqdn_internal}:8443" \
      --node-name "agent-${index}" \
      --advertised-endpoint "https://$PRIV:9443" \
      --migration-host "$PRIV" \
      --migration-port-range-start 49152 \
      --migration-port-range-end 49251 \
      --wireguard-advertised-endpoint "$PRIV:51820" \
      --listen "0.0.0.0:9443" \
      --force
    set -x

    # bootstrap ran as root, so hand the cert material, config, and pool mounts
    # to the otherix user the serve process runs under (User=otherix).
    chown -R otherix:otherix /var/lib/otherix
    if [ -f /etc/otherix/agent.yaml ]; then
      chown otherix:otherix /etc/otherix/agent.yaml
    fi

    # Ensure the unit is enabled and running to pick up the fresh files.
    systemctl enable --now otherix-agent
    systemctl restart otherix-agent
