# shellcheck shell=sh
# Personal AWS credential hook for the harness (EXAMPLE - copy, do not edit here).
#
# Copy to dev/aws/aws-creds.local.sh (gitignored) only if the ambient AWS
# credential chain does not already resolve on your machine. The harness sources
# it via dev/aws/ensure-aws-creds.sh, so it just needs to make working AWS_*
# credentials available. Pick whatever fits your setup, for example:
#
#   export AWS_PROFILE=otherix-harness
#
# or export them from your own credential source:
#
#   eval "$(aws configure export-credentials --profile otherix-harness --format env)"
#
# Anything you put in the real file stays on your machine only.
