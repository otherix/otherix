# Demo VM manifest TEMPLATE for the local dev stack.
#
# local-dev-start (and `make demo-manifest`) render this to the gitignored
# dev/manifests/demo-vm.yaml for THIS host's architecture - the dev node arch
# equals the host arch, so the VM uses KVM instead of cross-arch TCG. Apply the
# rendered file:
#   ./bin/otherix create -f dev/manifests/demo-vm.yaml --wait
#
# __ARCH__ and __IMAGE_URL__ are substituted at render time (amd64 or arm64).
apiVersion: otherix/v1
kind: VM
metadata:
  name: demo
spec:
  imageURL: __IMAGE_URL__
  arch: __ARCH__
  vcpus: 2
  memoryMB: 2048
  # cloud-init: set the hostname and reset the default ubuntu user's password
  # so you can log in on the serial console (`otherix vm console demo`).
  # Dev-only convenience - do not reuse this password anywhere real.
  cloudInit: |
    #cloud-config
    hostname: demo
    chpasswd:
      expire: false
      users:
        - name: ubuntu
          password: demo
          type: text
    ssh_pwauth: true
