# Two independent resources, so a single-shot `create -f` / `delete -f`
# exercises the manifest mechanics (multi-doc ordering, projection, reverse-order
# delete) WITHOUT the VM<->Network reconcile/teardown dependency: the VM is not
# attached to smoke-mf-net, so its placement does not wait on the network
# reconciling and the network delete is not blocked by the VM's NIC. The
# attached-VM-on-a-manifest-network flow (which needs sequencing) is covered by
# the networking smoke; the single-apply dependency gap is a ROADMAP backlog
# item. Only @@IMAGE_URL@@ / @@ARCH@@ are substituted.
apiVersion: otherix/v1
kind: Network
metadata:
  name: smoke-mf-net
spec:
  type: bridge
  managed: true
  bridgeName: otmf0
  mtu: 1500
---
apiVersion: otherix/v1
kind: VM
metadata:
  name: smoke-mf
spec:
  imageURL: "@@IMAGE_URL@@"
  arch: "@@ARCH@@"
  vcpus: 2
  memoryMB: 2048
